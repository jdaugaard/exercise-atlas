{
  "name": "exercise-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A curated exercise catalog, original line-art illustrations and a read-only API.",
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "catalog:check": "node scripts/check-catalog.ts",
    "docs:generate": "node scripts/render-examples.ts",
    "skill:install": "node scripts/install-skill.ts",
    "verify": "npm run typecheck && npm run catalog:check && npm test"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
